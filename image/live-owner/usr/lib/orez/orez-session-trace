#!/bin/sh
# Temporary, privacy-minimised OREZ login diagnostic.
# Preserve the exact native Plasma session command and its exit status.
set -u

log() {
    message=$1
    if [ -x /usr/bin/logger ]; then
        /usr/bin/logger -t orez-session-trace -- "$message" 2>/dev/null || printf '%s\n' "$message" >&2
    else
        printf '%s\n' "$message" >&2
    fi
}

if [ "$#" -ne 0 ]; then
    log "invalid wrapper arguments; refusing to launch an alternate command"
    exit 64
fi

uid=$(/usr/bin/id -u 2>/dev/null || printf unknown)
dbus_set=no
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && dbus_set=yes
log "wrapper_started uid=$uid home=${HOME:-unset} runtime_dir=${XDG_RUNTIME_DIR:-unset} dbus_address_set=$dbus_set wayland_display=${WAYLAND_DISPLAY:-unset} display=${DISPLAY:-unset} session_type=${XDG_SESSION_TYPE:-unset} current_desktop=${XDG_CURRENT_DESKTOP:-unset} lang=${LANG:-unset}"

# Keep this exact helper and target visible in the journal for process tracing.
log "starting plasma-dbus-run-session-if-needed -> startplasma-wayland"
 /usr/lib/x86_64-linux-gnu/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
status=$?
log "plasma_session_child_exit=$status"
exit "$status"
