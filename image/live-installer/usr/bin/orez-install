#!/bin/sh
# OREZ live installer launcher. Requires the owner's password (polkit), unlike
# Kubuntu's passwordless live sudo. Passes only the display variables Calamares
# needs to draw its window on the owner's desktop.
set -eu
exec pkexec /usr/bin/env \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" DISPLAY="${DISPLAY:-}" XAUTHORITY="${XAUTHORITY:-}" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" QT_QPA_PLATFORM="${WAYLAND_DISPLAY:+wayland}" \
  /usr/bin/calamares -D6
